<odoo>
    <template id="coaching_page_template" name="Cricket Coaching Page">
    <t t-call="website.layout">
    <section class="coaching-banner">
    <div class="overlay"></div>
    <div class="coaching-content">
        <h2 class="coaching-title" data-aos="fade-up" style="font-family:Roboto !important;font-size:40px; color:#d7af43!important">
            Our Cricket Coaching &amp; Training Programs At US Arena
        </h2>
        <h3 class="coaching-subtitle" data-aos="fade-up" data-aos-delay="200" style="font-family:Roboto !important;font-size:25px;">
            Develop Your Skills at Boston’s Premier Cricket Academy
        </h3>
        <p class="coaching-description" data-aos="fade-up" data-aos-delay="400" style="font-family:Roboto !important;font-size:18px;">
            Welcome to United Sports Arena, where we provide professional cricket coaching and training tailored for every level of experience. Whether you’re a beginner eager to learn the basics or an advanced player aiming to polish your skills, our diverse programs are designed to cater to all needs.
        </p>
    </div>
</section>
<!-- Coming Soon Section -->
<section class="coming-soon-section">
    <h2 class="coming-soon-text">Coming Soon.</h2>
</section>

<!-- Styles -->
<style>
    body {
        overflow-x: hidden;
    }

    .coaching-banner {
        position: relative;
        width: 100%;
        height: 450px;
        background: url('/us_arena_website/static/src/img/bgimgae.png') no-repeat center center/cover;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 20px;
        animation: zoomInOut 10s ease-in-out infinite;
    }

    /* Dark Overlay */
    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
    }

    /* Content */
    .coaching-content {
        position: relative;
        max-width: 800px;
        color: white;
        padding: 20px;
    }

    /* Title */
    .coaching-title {
        font-size: 2.5rem;
        font-weight: bold;
        color: #ffcc00;
        animation: float 3s ease-in-out infinite;
    }

    .coaching-subtitle {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 10px 0;
        animation: float 3s ease-in-out infinite 0.2s;
    }

    .coaching-description {
        font-size: 1rem;
        line-height: 1.6;
        color: #e0e0e0;
        animation: float 3s ease-in-out infinite 0.4s;
    }

    /* Coming Soon Section */
    .coming-soon-section {
        width: 100%;
        background: white;
        padding: 40px 20px;
        text-align: center;
    }

    .coming-soon-text {
        font-family: Roboto, sans-serif;
        font-size: 2rem;
        font-weight: 600;
        color: #d4a017;
    }

    /* Zoom Animation for Background Image */
    @keyframes zoomInOut {
        0% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.1);
        }
        100% {
            transform: scale(1);
        }
    }

    @media (max-width: 768px) {
        .coaching-banner {
            height: 350px;
            padding: 10px;
        }

        .coaching-title {
            font-size: 1.8rem;
        }

        .coaching-subtitle {
            font-size: 1.2rem;
        }

        .coaching-description {
            font-size: 0.9rem;
        }

        .coming-soon-text {
            font-size: 1.5rem;
        }
    }
</style>

<script>
    AOS.init();
</script>


        </t>
