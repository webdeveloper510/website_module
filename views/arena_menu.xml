<odoo>
    <data>

        <record id="product_slot_action" model="ir.actions.act_window">
            <field name="name">Product Slots</field>
            <field name="res_model">product.slot</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
        </record>

        <menuitem id="menu_arena" name="Cricket Arena" sequence='1' action="product_slot_action"/>

        <record id="view_product_slot_tree" model="ir.ui.view">
            <field name="name">product.slot.tree</field>
            <field name="model">product.slot</field>
            <field name="arch" type="xml">
                <list string="Arena" sample="1" multi_edit="1">
                    <field name="product_name"/>
                    <field name="lane_name"/>
                    <field name="is_booked"/>
                    <field name="date"/>
                    <field name="time_slot"/>
                    <field name="user_id"/>
                </list>
            </field>
        </record>
        <!-- <record id="view_order_form_inherit_selected_slots" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.selected.slots</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <group string="Selected Details" invisible="1">
                        <field name="selected_slots"/>
                        <field name="selected_addons"/>
                    </group>
                </xpath>
            </field>
        </record> -->

        <record id="view_product_slot_form" model="ir.ui.view">
            <field name="name">product.slot.form</field>
            <field name="model">product.slot</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="product_id"/>
                            <field name="lane_name"/>
                            <field name="date"/>
                            <field name="sale_id" />
                            <field name="time_slot"/>
                            <field name="is_booked"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
