            <script>
                document.addEventListener('DOMContentLoaded', function () {
                const aboutSection = document.getElementById('about-us-section');
                const leftText = document.querySelector('.animate-left');
                const rightImage = document.querySelector('.animate-right');

                // Create an intersection observer to detect when the section is in view
                const observer = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                if (entry.isIntersecting) {
                // Add active class to trigger the animation
                leftText.classList.add('active');
                rightImage.classList.add('active');
                } else {
                // Remove active class when the section goes out of view
                leftText.classList.remove('active');
                rightImage.classList.remove('active');
                }
                });
                }, { threshold: 0.5 }); // Trigger when 50% of the section is visible

                // Start observing the section
                observer.observe(aboutSection);
                });
            </script>


