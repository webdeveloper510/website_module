<style>
/* Global Font Styling */
body, .feature-card, .feature-card p, .feature-card h2 {
    font-family: 'Roboto', sans-serif;
}

/* Feature Container */
.feature-container {
    display: flex;
    justify-content: center;
    flex-wrap: nowrap;
    width: 100vw;
    overflow-x: auto;
    padding-bottom: 10px;
    gap: 15px;
}

/* Feature Card */
.feature-card {
    width: 220px; /* Increased width */
    height: 120px; /* Increased height */
    padding: 20px;
    text-align: center;
    font-weight: bold;
    border-radius: 12px;
    transform: skewX(-5deg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    transition: transform 0.5s ease-in-out, opacity 0.5s ease-in-out;
    flex-shrink: 0;
}

/* Background Colors */
.light-bg { background-color: #bbd9dd; }
.dark-bg { background-color: #5a5d63; }

/* Font Styling */
.feature-card h2 {
    font-size: 26px;
    margin-bottom: 5px;
    font-weight: bold;
}
.feature-card p {
    font-size: 15px;
    margin-bottom: 0;
    font-weight: normal;
}

/* Responsive Adjustments */
@media (max-width: 992px) {
    .feature-container {
        flex-wrap: wrap;
    }
    .feature-card {
        width: 240px;
        height: 130px;
    }
}
@media (max-width: 768px) {
    .feature-container {
        flex-direction: column;
        align-items: center;
    }
    .feature-card {
        width: 90%;
        max-width: 270px;
        height: auto;
        transform: none;
        padding: 20px;
    }
    .feature-card-link {
        width: 100%;
        max-width: 270px;
        display: flex;
        justify-content: center;
    }
    .feature-card-link .feature-card {
        width: 100%;
    }
}

/* Animation Keyframes */
@keyframes slideFromLeft {
    from { transform: translateX(-100px) skewX(-5deg); opacity: 0; }
    to { transform: translateX(0) skewX(-5deg); opacity: 1; }
}
@keyframes slideFromRight {
    from { transform: translateX(100px) skewX(-5deg); opacity: 0; }
    to { transform: translateX(0) skewX(-5deg); opacity: 1; }
}
@keyframes slideFromTop {
    from { transform: translateY(-50px) skewX(-5deg); opacity: 0; }
    to { transform: translateY(0) skewX(-5deg); opacity: 1; }
}

/* Assigning Animations */
.animate-left.show { animation: slideFromLeft 1s ease-in-out forwards; }
.animate-right.show { animation: slideFromRight 1s ease-in-out forwards; }
.animate-top.show { animation: slideFromTop 1s ease-in-out forwards; }

/* Delayed Animation for Staggered Effect */
.animate-left:nth-child(1) { animation-delay: 0.2s; }
.animate-right:nth-child(2) { animation-delay: 0.4s; }
.animate-top:nth-child(3) { animation-delay: 0.6s; }
.animate-right:nth-child(4) { animation-delay: 0.8s; }
.animate-left:nth-child(5) { animation-delay: 1s; }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
    let observer = new IntersectionObserver(function (entries) {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add("show");
            } else {
                entry.target.classList.remove("show"); // Reset animation when out of view
            }
        });
    }, { threshold: 0.3 });

    document.querySelectorAll(".feature-card").forEach(card => {
        observer.observe(card);
    });
});
</script>


