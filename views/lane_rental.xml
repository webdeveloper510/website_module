            <style>
                /* General Button Styling */
                .btn {
                border-radius: 8px;
                padding: 12px 24px;
                font-size: 1rem;
                text-align: center;
                transition: all 0.3s ease;
                }
                body{
                background: linear-gradient(to right, #2c3e50, #822f3f); /* Dark navy to dark maroon */
                }

                /* Slot Button Styling */
                .slot-btn {
                padding: 10px 20px;
                font-size: 1rem;
                border-radius: 12px;
                min-width: 100px;
                transition: background-color 0.3s ease, transform 0.2s ease;
                }

                .slot-btn:hover {
                background-color: #0069d9;
                color: white;
                transform: scale(1.1);
                }

                /* Selected Slot Button Styling */
                .selected-slot {
                background-color: #2575fc;
                color: white;
                }

                /* Add to Cart Button Styling */
                #add_to_cart {
                background-color: #2575fc;
                color: white;
                border: none;
                font-size: 1rem;
                padding: 10px 20px;
                border-radius: 20px;
                transition: all 0.3s ease;
                display: inline-flex;
                align-items: center;
                }

                #add_to_cart:hover {
                background-color: #0069d9;
                transform: scale(1.05);
                }

                #show_all_slots {
                background-color: #2575fc;
                color: white;
                border: none;
                font-size: 1rem;
                padding: 10px 20px;
                border-radius: 20px;
                transition: all 0.3s ease;
                display: inline-flex;
                align-items: center;
                }

                #show_all_slots:hover {
                background-color: #0069d9;
                transform: scale(1.05);
                }

                /* For Mobile */
                @media (max-width: 768px) {
                .modal-body {
                max-height: 70vh;
                overflow-y: auto;
                }
                }
            </style>

            <script>
                document.getElementById('show_all_slots').addEventListener('click', function() {
                $('#slotsModal').modal('show');
                });

                function selectSlot(slot) {
                const availableSlotsDiv = document.getElementById('available_slots');

                if (availableSlotsDiv.innerHTML.includes(slot)) {
                return;
                }

                const selectedSlotButton = document.createElement('button');
                selectedSlotButton.classList.add('btn', 'btn-outline-primary', 'slot-btn');
                selectedSlotButton.innerHTML = slot;

                availableSlotsDiv.appendChild(selectedSlotButton);
                }

                function toggleDateFields() {
                var bookingType = document.getElementById('booking_type').value;
                var dailyDateRange = document.getElementById('daily_date_range');
                var monthlyDateRange = document.getElementById('monthly_date_range');
                var monthlyToDateRange = document.getElementById('monthly_to_date_range');

                if (bookingType === 'daily') {
                dailyDateRange.style.display = 'block';
                monthlyDateRange.style.display = 'none';
                monthlyToDateRange.style.display = 'none';
                } else {
                dailyDateRange.style.display = 'none';
                monthlyDateRange.style.display = 'block';
                monthlyToDateRange.style.display = 'block';
                }
                }
            </script>
        </t>
