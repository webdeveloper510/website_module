<odoo>

        <record id="team_action" model="ir.actions.act_window">
            <field name="name">Teams</field>
            <field name="res_model">our.team</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_team" name="Teams" parent="menu_arena" sequence="3" action="team_action"/>

        <record id="view_teams_tree" model="ir.ui.view">
            <field name="name">teams.tree</field>
            <field name="model">our.team</field>
            <field name="arch" type="xml">
                <list string="Teams">
                    <field name="name"/>
                    <field name="image"/>
                    <field name="coach_name"/>
                                    <field name="training_timing"/>
                                    <field name="age_group"/>
                </list>
            </field>
        </record>

     <record id="view_teams_form" model="ir.ui.view">
                    <field name="name">teams.form</field>
                    <field name="model">our.team</field>
                    <field name="arch" type="xml">
                        <form string="Teams">
                            <sheet>
                                <group>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="image"/>
                                    <field name="coach_name"/>
                                    <field name="training_timing"/>
                                    <field name="age_group"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </record>

</odoo>
